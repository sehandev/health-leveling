{
  "name": "health-leveling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:cf": "cf dev",
    "dev:pi-bridge": "node bridge/server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test $(find src/domain src/server src/lib src/components bridge -type f -name '*.test.*' -print 2>/dev/null)"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.160.1"
  }
}
